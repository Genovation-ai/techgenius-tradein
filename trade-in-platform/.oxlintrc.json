{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "ignorePatterns": [
    "dist/**",
    "dist-embed/**",
    "dist-embed-lite/**",
    "framer-upload/**",
    "Downloads/**",
    "node_modules/**",
    "_archive/**",
    "embed-preview.html"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  }
}
