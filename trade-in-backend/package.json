{
  "name": "tg-trade-in-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "scrape": "python3 scripts/scrapling_worker.py",
    "train": "tsx -e \"import { PricingTraining } from './src/pricing-engine/training/train.ts'; console.log(PricingTraining.train())\"",
    "smoke:pricing": "tsx scripts/smoke_pricing_engine.ts",
    "test:live-scrapers": "tsx scripts/test_live_scrapers.ts",
    "test:scraper-reliability": "tsx scripts/reliability_live_scrapers.ts",
    "test:device-match": "tsx scripts/test_device_match.ts",
    "test:gorecell": "tsx scripts/test_gorecell_query_flow.ts",
    "sync:catalog-prices": "tsx scripts/sync_gorecell_catalog_prices.ts",
    "cron:scrape": "curl -sS -X POST http://127.0.0.1:${TG_API_PORT:-4100}/api/cron/scrape -H \"x-cron-secret: ${TG_CRON_SECRET:-tg-dev-key-2026}\" -H 'Content-Type: application/json' -d '{}'",
    "cron:sync-catalog": "curl -sS -X POST http://127.0.0.1:${TG_API_PORT:-4100}/api/cron/sync-catalog -H \"x-cron-secret: ${TG_CRON_SECRET:-tg-dev-key-2026}\" -H 'Content-Type: application/json' -d '{}'",
    "cron:weekly": "curl -sS -X POST http://127.0.0.1:${TG_API_PORT:-4100}/api/cron/weekly -H \"x-cron-secret: ${TG_CRON_SECRET:-tg-dev-key-2026}\" -H 'Content-Type: application/json' -d '{}'",
    "cron:train": "curl -sS -X POST http://127.0.0.1:${TG_API_PORT:-4100}/api/cron/train -H \"x-cron-secret: ${TG_CRON_SECRET:-tg-dev-key-2026}\"",
    "device:from-name": "tsx scripts/ensure_device_from_name.ts",
    "device:build-image": "python3 scripts/build_device_image.py",
    "images:backfill": "cd scripts && python3 backfill_device_images.py",
    "images:audit": "cd scripts && python3 audit_device_images.py",
    "test:images": "cd scripts && python3 test_image_resolver.py",
    "test:quote-guard": "tsx scripts/test_quote_guard.ts",
    "catalog:dedupe": "cd scripts && python3 dedupe_catalog.py",
    "catalog:dedupe:apply": "cd scripts && python3 dedupe_catalog.py --apply",
    "audit:catalog": "cd scripts && python3 audit_catalog.py",
    "audit:quotes": "tsx scripts/audit_effective_quotes.ts",
    "fix:prices": "cd scripts && python3 fix_price_integrity.py",
    "fix:prices:apply": "cd scripts && python3 fix_price_integrity.py --apply",
    "health:scrapers": "tsx scripts/scraper_health.ts",
    "smoke:api": "bash scripts/smoke_all_endpoints.sh"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "nanoid": "^5.0.0",
    "playwright": "^1.62.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^22.20.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
